#!/bin/sh
# /usr/lib/systemd/system-sleep/10-bluetooth
case "$1/$2" in
    pre/*)
      # Disconnect peers cleanly and bring adapter down
      bluetoothctl -- power off
      ;;
    post/*)
      # Bring adapter back; AutoEnable=true also handles this,
      # but explicit is fine
      bluetoothctl -- power on
      ;;
esac
