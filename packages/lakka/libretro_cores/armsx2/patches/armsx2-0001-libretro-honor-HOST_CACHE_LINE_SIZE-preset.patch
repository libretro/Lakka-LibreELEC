From 4d83f534b8f8126790a12e8ea5304755cdc70618 Mon Sep 17 00:00:00 2001
From: yasai <yasai@example.com>
Date: Wed, 16 Sep 2026 12:58:33 +0000
Subject: [PATCH] libretro: honor HOST_CACHE_LINE_SIZE preset when
 cross-compiling

---
 cmake/Pcsx2Utils.cmake | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/cmake/Pcsx2Utils.cmake b/cmake/Pcsx2Utils.cmake
index 813722e..71d0e7b 100644
--- a/cmake/Pcsx2Utils.cmake
+++ b/cmake/Pcsx2Utils.cmake
@@ -270,6 +270,13 @@ int main() {
 endfunction()
 
 function(detect_cache_line_size)
+	# Same escape hatch as detect_page_size() above: pre-setting
+	# HOST_CACHE_LINE_SIZE (e.g. -DHOST_CACHE_LINE_SIZE=64) skips the try_run,
+	# which is required when cross-compiling.
+	if(DEFINED HOST_CACHE_LINE_SIZE)
+		message(STATUS "Host cache line size (preset): ${HOST_CACHE_LINE_SIZE}")
+		return()
+	endif()
 	message(STATUS "Determining host cache line size")
 	set(detect_cache_line_size_file ${CMAKE_BINARY_DIR}${CMAKE_FILES_DIRECTORY}/CMakeTmp/src.c)
 	file(WRITE ${detect_cache_line_size_file} "
-- 
2.43.0

