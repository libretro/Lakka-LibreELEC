 arch/arm64/boot/dts/amlogic/Makefile          |   3 +
 .../boot/dts/amlogic/meson-gxl-s905l2-x7-5g.dts  |  31 ++
 .../meson-gxl-s905l3b-e900v22e.dts            |  76 +++
 .../amlogic/meson-gxl-s905l3b-m302a.dts       | 105 +++
