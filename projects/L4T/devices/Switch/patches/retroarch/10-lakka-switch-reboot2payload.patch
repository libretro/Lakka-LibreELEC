diff --git a/misc/reboot2payload/reboot2payload.c b/misc/reboot2payload/reboot2payload.c
new file mode 100644
index 0000000..0df1011
--- /dev/null
+++ b/misc/reboot2payload/reboot2payload.c
@@ -0,0 +1,494 @@
+/*  RetroArch - A frontend for libretro.
+ *
+ *  RetroArch is free software: you can redistribute it and/or modify it under
+ *  the terms of the GNU General Public License as published by the Free
+ *  Software Foundation, either version 3 of the License, or (at your option)
+ *  any later version.
+ *
+ *  RetroArch is distributed in the hope that it will be useful, but WITHOUT
+ *  ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ *  FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ *  more details.
+ *
+ *  You should have received a copy of the GNU General Public License along
+ *  with RetroArch. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+
+#include <boolean.h>
+#include <retro_common_api.h>
+#include <retro_miscellaneous.h>
+
+#include <file/file_path.h>
+#include <lists/dir_list.h>
+#include <lists/string_list.h>
+#include <streams/file_stream.h>
+#include <string/stdstring.h>
+
+#include "reboot2payload.h"
+#include "../../verbosity.h"
+
+#define R2P_SYSFS_DIR     "/sys/devices/r2p"
+#define R2P_SYSFS_ACTION  R2P_SYSFS_DIR "/action"
+#define R2P_SYSFS_PARAM1  R2P_SYSFS_DIR "/param1"
+#define R2P_SYSFS_PARAM2  R2P_SYSFS_DIR "/param2"
+
+/* Lakka's initramfs always mounts the FAT boot partition at /flash. */
+#define R2P_BOOT_ROOT     "/flash"
+#define R2P_HEKATE_IPL    R2P_BOOT_ROOT "/bootloader/hekate_ipl.ini"
+#define R2P_HEKATE_INIDIR R2P_BOOT_ROOT "/bootloader/ini"
+
+/* Matches the patterns the Lakka initramfs check_update step scans. */
+#define R2P_UPDATE_DIR    "/storage/.update"
+
+#define R2P_CMDLINE_PATH  "/proc/cmdline"
+#define R2P_DEFAULT_ACTION "self"
+#define R2P_SELF_SUFFIX   " (self)"
+
+static r2p_payload_t *r2p_list             = NULL;
+static size_t         r2p_list_count       = 0;
+static size_t         r2p_list_capacity    = 0;
+static size_t         r2p_selected         = 0;
+static bool           r2p_list_initialized = false;
+
+/* Parsed copy of pmc_r2p.* from /proc/cmdline; seeds default selection
+ * and feeds r2p_arm_self(). */
+static char     r2p_self_action[16] = R2P_DEFAULT_ACTION;
+static unsigned r2p_self_param1     = 0;
+static unsigned r2p_self_param2     = 0;
+
+static bool r2p_append_payload(const char *name,
+      enum r2p_payload_kind kind, unsigned index)
+{
+   r2p_payload_t *slot;
+
+   if (string_is_empty(name))
+      return false;
+
+   if (r2p_list_count >= r2p_list_capacity)
+   {
+      size_t new_cap       = (r2p_list_capacity == 0)
+            ? 8 : r2p_list_capacity * 2;
+      r2p_payload_t *grown = (r2p_payload_t *)realloc(r2p_list,
+            new_cap * sizeof(*grown));
+      if (!grown)
+         return false;
+      r2p_list             = grown;
+      r2p_list_capacity    = new_cap;
+   }
+
+   slot        = &r2p_list[r2p_list_count];
+   strlcpy(slot->name, name, sizeof(slot->name));
+   slot->kind  = kind;
+   slot->index = index;
+   r2p_list_count++;
+   return true;
+}
+
+static char *r2p_trim(char *s)
+{
+   char *end;
+   if (!s)
+      return s;
+   while (*s && isspace((unsigned char)*s))
+      s++;
+   end = s + strlen(s);
+   while (end > s && isspace((unsigned char)end[-1]))
+      end--;
+   *end = '\0';
+   return s;
+}
+
+static void r2p_parse_cmdline(void)
+{
+   RFILE *fp;
+   char   line[1024];
+   char  *tok;
+   char  *saveptr = NULL;
+
+   strlcpy(r2p_self_action, R2P_DEFAULT_ACTION, sizeof(r2p_self_action));
+   r2p_self_param1 = 0;
+   r2p_self_param2 = 0;
+
+   if (!(fp = filestream_open(R2P_CMDLINE_PATH,
+               RETRO_VFS_FILE_ACCESS_READ,
+               RETRO_VFS_FILE_ACCESS_HINT_NONE)))
+      return;
+
+   if (!filestream_gets(fp, line, sizeof(line)))
+   {
+      filestream_close(fp);
+      return;
+   }
+   filestream_close(fp);
+
+   for (tok = strtok_r(line, " \t\r\n", &saveptr);
+         tok;
+         tok = strtok_r(NULL, " \t\r\n", &saveptr))
+   {
+      const char *eq = strchr(tok, '=');
+      if (!eq)
+         continue;
+      if (!strncmp(tok, "pmc_r2p.action=", 15))
+         strlcpy(r2p_self_action, eq + 1, sizeof(r2p_self_action));
+      else if (!strncmp(tok, "pmc_r2p.param1=", 15))
+         r2p_self_param1 = (unsigned)strtoul(eq + 1, NULL, 0);
+      else if (!strncmp(tok, "pmc_r2p.param2=", 15))
+         r2p_self_param2 = (unsigned)strtoul(eq + 1, NULL, 0);
+   }
+}
+
+static void r2p_parse_ini_file(const char *ini_path,
+      enum r2p_payload_kind kind, unsigned *index_inout)
+{
+   RFILE *fp = filestream_open(ini_path,
+         RETRO_VFS_FILE_ACCESS_READ,
+         RETRO_VFS_FILE_ACCESS_HINT_NONE);
+   char   line[256];
+
+   if (!fp)
+      return;
+
+   while (filestream_gets(fp, line, sizeof(line)))
+   {
+      char  *trimmed = r2p_trim(line);
+      size_t tlen;
+
+      if (string_is_empty(trimmed))
+         continue;
+      if (trimmed[0] != '[')
+         continue;
+
+      tlen = strlen(trimmed);
+      if (tlen < 2 || trimmed[tlen - 1] != ']')
+         continue;
+
+      trimmed[tlen - 1] = '\0';
+      trimmed++;
+      trimmed           = r2p_trim(trimmed);
+
+      if (string_is_empty(trimmed))
+         continue;
+      /* hekate's [config] is global options, not a launch entry. */
+      if (string_is_equal_case_insensitive(trimmed, "config"))
+         continue;
+
+      r2p_append_payload(trimmed, kind, *index_inout);
+      (*index_inout)++;
+   }
+
+   filestream_close(fp);
+}
+
+static void r2p_clear_payloads(void)
+{
+   if (r2p_list)
+      free(r2p_list);
+   r2p_list          = NULL;
+   r2p_list_count    = 0;
+   r2p_list_capacity = 0;
+}
+
+/* Returns the list index that matches the kernel cmdline values, or
+ * 0 (Hekate Menu) when no parsed entry does. */
+static size_t r2p_index_for_self(void)
+{
+   size_t i;
+
+   if (string_is_equal_case_insensitive(r2p_self_action, "bootloader"))
+      return 0;
+
+   if (string_is_equal_case_insensitive(r2p_self_action, "self"))
+   {
+      enum r2p_payload_kind want_kind = (r2p_self_param2 == 1)
+            ? R2P_KIND_INI_CONFIG
+            : R2P_KIND_LAUNCH;
+
+      for (i = 0; i < r2p_list_count; i++)
+      {
+         const r2p_payload_t *p = &r2p_list[i];
+         if (p->kind == want_kind && p->index == r2p_self_param1)
+            return i;
+      }
+   }
+   return 0;
+}
+
+bool r2p_is_supported(void)
+{
+   return path_is_directory(R2P_SYSFS_DIR);
+}
+
+size_t r2p_refresh_payloads(void)
+{
+   unsigned launch_index = 1;
+   unsigned cfg_index    = 1;
+
+   r2p_clear_payloads();
+   r2p_parse_cmdline();
+
+   r2p_append_payload("Hekate Menu", R2P_KIND_BOOTLOADER, 0);
+
+   if (path_is_valid(R2P_HEKATE_IPL))
+      r2p_parse_ini_file(R2P_HEKATE_IPL, R2P_KIND_LAUNCH, &launch_index);
+
+   if (path_is_directory(R2P_HEKATE_INIDIR))
+   {
+      struct string_list *ini_files = dir_list_new(R2P_HEKATE_INIDIR,
+            "ini", false, false, false, false);
+      if (ini_files)
+      {
+         size_t i;
+         dir_list_sort(ini_files, true);
+         for (i = 0; i < ini_files->size; i++)
+            r2p_parse_ini_file(ini_files->elems[i].data,
+                  R2P_KIND_INI_CONFIG, &cfg_index);
+         string_list_free(ini_files);
+      }
+   }
+
+   r2p_selected         = r2p_index_for_self();
+   r2p_list_initialized = true;
+
+   RARCH_LOG("[R2P] %u entries loaded; cmdline action=%s "
+         "param1=%u param2=%u, default idx=%u\n",
+         (unsigned)r2p_list_count, r2p_self_action,
+         r2p_self_param1, r2p_self_param2,
+         (unsigned)r2p_selected);
+
+   return r2p_list_count;
+}
+
+size_t r2p_get_payload_count(void)
+{
+   if (!r2p_list_initialized)
+      r2p_refresh_payloads();
+   return r2p_list_count;
+}
+
+const r2p_payload_t *r2p_get_payload(size_t index)
+{
+   if (!r2p_list_initialized)
+      r2p_refresh_payloads();
+   if (index >= r2p_list_count)
+      return NULL;
+   return &r2p_list[index];
+}
+
+size_t r2p_get_selected_index(void)
+{
+   if (!r2p_list_initialized)
+      r2p_refresh_payloads();
+   return r2p_selected;
+}
+
+size_t r2p_set_selected_index(size_t index)
+{
+   if (!r2p_list_initialized)
+      r2p_refresh_payloads();
+   if (r2p_list_count == 0)
+      return 0;
+   if (index >= r2p_list_count)
+      index = r2p_list_count - 1;
+   r2p_selected = index;
+   return r2p_selected;
+}
+
+size_t r2p_cycle_selection(bool forward)
+{
+   if (!r2p_list_initialized)
+      r2p_refresh_payloads();
+   if (r2p_list_count == 0)
+      return 0;
+
+   if (forward)
+   {
+      r2p_selected++;
+      if (r2p_selected >= r2p_list_count)
+         r2p_selected = 0;
+   }
+   else
+   {
+      if (r2p_selected == 0)
+         r2p_selected = r2p_list_count - 1;
+      else
+         r2p_selected--;
+   }
+   return r2p_selected;
+}
+
+void r2p_get_selected_persistable(unsigned *out_kind,
+      const char **out_name)
+{
+   const r2p_payload_t *p;
+
+   if (!r2p_list_initialized)
+      r2p_refresh_payloads();
+
+   p = (r2p_selected < r2p_list_count) ? &r2p_list[r2p_selected] : NULL;
+   if (out_kind)
+      *out_kind = p ? (unsigned)p->kind : (unsigned)R2P_KIND_BOOTLOADER;
+   if (out_name)
+      *out_name = (p && p->name[0]) ? p->name : "";
+}
+
+size_t r2p_restore_persisted_selection(unsigned saved_kind,
+      const char *saved_name)
+{
+   size_t i;
+
+   if (!r2p_list_initialized)
+      r2p_refresh_payloads();
+   if (!saved_name || !saved_name[0])
+      return r2p_selected;
+
+   /* Match by name so the restore survives INI reordering between
+    * sessions. */
+   for (i = 0; i < r2p_list_count; i++)
+   {
+      const r2p_payload_t *p = &r2p_list[i];
+      if (   (unsigned)p->kind == saved_kind
+          && string_is_equal(p->name, saved_name))
+      {
+         r2p_selected = i;
+         return r2p_selected;
+      }
+   }
+
+   r2p_selected = r2p_index_for_self();
+   RARCH_WARN("[R2P] Persisted payload \"%s\" not found; "
+         "falling back to cmdline self (idx=%u)\n",
+         saved_name, (unsigned)r2p_selected);
+   return r2p_selected;
+}
+
+static bool r2p_write_sysfs(const char *action,
+      const char *param1, const char *param2)
+{
+   if (!filestream_write_file(R2P_SYSFS_ACTION, action, strlen(action)))
+   {
+      RARCH_ERR("[R2P] Failed to write %s.\n", R2P_SYSFS_ACTION);
+      return false;
+   }
+   if (!filestream_write_file(R2P_SYSFS_PARAM1, param1, strlen(param1)))
+   {
+      RARCH_ERR("[R2P] Failed to write %s.\n", R2P_SYSFS_PARAM1);
+      return false;
+   }
+   if (!filestream_write_file(R2P_SYSFS_PARAM2, param2, strlen(param2)))
+   {
+      RARCH_ERR("[R2P] Failed to write %s.\n", R2P_SYSFS_PARAM2);
+      return false;
+   }
+   return true;
+}
+
+bool r2p_arm_selected(void)
+{
+   const r2p_payload_t *p = r2p_get_payload(r2p_selected);
+   const char          *action;
+   char                 param1_str[16];
+   char                 param2_str[4];
+
+   if (!p)
+      return false;
+
+   switch (p->kind)
+   {
+      case R2P_KIND_BOOTLOADER:
+         action = "bootloader";
+         strlcpy(param1_str, "0", sizeof(param1_str));
+         strlcpy(param2_str, "0", sizeof(param2_str));
+         break;
+      case R2P_KIND_LAUNCH:
+         action = "self";
+         snprintf(param1_str, sizeof(param1_str), "%u", p->index);
+         strlcpy(param2_str, "0", sizeof(param2_str));
+         break;
+      case R2P_KIND_INI_CONFIG:
+         action = "self";
+         snprintf(param1_str, sizeof(param1_str), "%u", p->index);
+         strlcpy(param2_str, "1", sizeof(param2_str));
+         break;
+      default:
+         return false;
+   }
+
+   if (!r2p_write_sysfs(action, param1_str, param2_str))
+      return false;
+
+   RARCH_LOG("[R2P] Armed action=%s param1=%s param2=%s (\"%s\")\n",
+         action, param1_str, param2_str, p->name);
+   return true;
+}
+
+bool r2p_arm_self(void)
+{
+   char param1_str[16];
+   char param2_str[16];
+
+   if (!r2p_list_initialized)
+      r2p_refresh_payloads();
+
+   snprintf(param1_str, sizeof(param1_str), "%u", r2p_self_param1);
+   snprintf(param2_str, sizeof(param2_str), "%u", r2p_self_param2);
+
+   if (!r2p_write_sysfs(r2p_self_action, param1_str, param2_str))
+      return false;
+
+   RARCH_LOG("[R2P] Armed self action=%s param1=%s param2=%s\n",
+         r2p_self_action, param1_str, param2_str);
+   return true;
+}
+
+bool r2p_update_pending(void)
+{
+   /* Matches the *.tar / *.img.gz / *.img patterns the Lakka
+    * initramfs check_update step looks for. */
+   static const char *patterns[] = { "tar", "img.gz", "img", NULL };
+   size_t i;
+
+   if (!path_is_directory(R2P_UPDATE_DIR))
+      return false;
+
+   for (i = 0; patterns[i]; i++)
+   {
+      struct string_list *list = dir_list_new(R2P_UPDATE_DIR,
+            patterns[i], false, false, false, false);
+      bool found = (list && list->size > 0);
+      if (list)
+         string_list_free(list);
+      if (found)
+         return true;
+   }
+   return false;
+}
+
+const char *r2p_get_destination_name(void)
+{
+   static char buf[R2P_NAME_MAXLEN + sizeof(R2P_SELF_SUFFIX)];
+   const r2p_payload_t *p = r2p_get_payload(r2p_get_selected_index());
+   const char          *name;
+
+   if (!p || !p->name[0])
+      return "Hekate Menu";
+
+   name = p->name;
+   if (r2p_get_selected_index() == r2p_index_for_self())
+   {
+      snprintf(buf, sizeof(buf), "%s%s", name, R2P_SELF_SUFFIX);
+      return buf;
+   }
+   return name;
+}
+
+void r2p_deinit(void)
+{
+   r2p_clear_payloads();
+   r2p_selected         = 0;
+   r2p_list_initialized = false;
+}
