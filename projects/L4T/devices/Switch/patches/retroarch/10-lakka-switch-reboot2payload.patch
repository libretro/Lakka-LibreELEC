new file mode 100644
index 0000000..2973e06
--- /dev/null
+++ b/misc/reboot2payload/reboot2payload.h
@@ -0,0 +1,76 @@
+/*  RetroArch - A frontend for libretro.
+ *
+ *  RetroArch is free software: you can redistribute it and/or modify it under
+ *  the terms of the GNU General Public License as published by the Free
+ *  Software Foundation, either version 3 of the License, or (at your option)
+ *  any later version.
+ *
+ *  RetroArch is distributed in the hope that it will be useful, but WITHOUT
+ *  ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ *  FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ *  more details.
+ *
+ *  You should have received a copy of the GNU General Public License along
+ *  with RetroArch. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef _MISC_REBOOT2PAYLOAD_H
+#define _MISC_REBOOT2PAYLOAD_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <boolean.h>
+#include <retro_common_api.h>
+
+RETRO_BEGIN_DECLS
+
+#define R2P_NAME_MAXLEN 64
+
+/* pmc_r2p sysfs protocol:
+ *    action=self,       param2=0  -> hekate_ipl.ini launch entry
+ *    action=self,       param2=1  -> bootloader/ini/[name].ini entry
+ *    action=bootloader, param2=0  -> drop into the Hekate menu  */
+enum r2p_payload_kind
+{
+   R2P_KIND_BOOTLOADER = 0,
+   R2P_KIND_LAUNCH,
+   R2P_KIND_INI_CONFIG
+};
+
+typedef struct r2p_payload
+{
+   char name[R2P_NAME_MAXLEN];
+   enum r2p_payload_kind kind;
+   unsigned index;
+} r2p_payload_t;
+
+bool                 r2p_is_supported(void);
+size_t               r2p_refresh_payloads(void);
+size_t               r2p_get_payload_count(void);
+const r2p_payload_t *r2p_get_payload(size_t index);
+size_t               r2p_get_selected_index(void);
+size_t               r2p_set_selected_index(size_t index);
+size_t               r2p_cycle_selection(bool forward);
+
+/* Persist / restore. Pair with settings->uints.reboot_payload_kind +
+ * settings->arrays.reboot_payload_name. Restore matches by name; falls
+ * back to the cmdline-self entry when no match is found. */
+void                 r2p_get_selected_persistable(unsigned *out_kind,
+                           const char **out_name);
+size_t               r2p_restore_persisted_selection(unsigned saved_kind,
