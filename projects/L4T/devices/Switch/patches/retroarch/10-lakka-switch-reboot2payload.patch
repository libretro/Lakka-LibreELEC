-   size_t _len = 0;
+   size_t      _len     = 0;
+   settings_t *settings = config_get_ptr();
 
    if (path && *path)
       strlcpy(s2, path, len2);
 
+#ifdef HAVE_LAKKA_SWITCH
+   {
+      const bool install_update = r2p_update_pending()
+            && settings
+            && settings->bools.reboot_force_self_on_update;
+      if (install_update)
+         _len = strlcpy(s, "Install Update", len);
+      else
+         _len = strlcpy(s, r2p_get_destination_name(), len);
+   }
+#else
+   (void)settings;
    if (lakka_update_pending())
       _len = strlcpy(s, "Install Update", len);
    else
       s[0] = '\0';
+#endif
 
    *w = (unsigned)_len;
    return _len;
