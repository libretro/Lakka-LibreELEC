+
+#ifdef HAVE_LAKKA_SWITCH
+/* Cycle backward and mirror the new selection into settings so the
+ * config-save-on-exit pipeline persists it. */
+static int reboot_payload_left(unsigned type, const char *label,
+      bool wraparound)
+{
+   struct menu_state *menu_st = menu_state_get_ptr();
+   settings_t       *settings = config_get_ptr();
+   unsigned          kind;
+   const char       *name;
+
+   r2p_cycle_selection(false);
+
+   r2p_get_selected_persistable(&kind, &name);
+   if (settings)
+   {
+      settings->uints.reboot_payload_kind = kind;
+      strlcpy(settings->arrays.reboot_payload_name, name,
+            sizeof(settings->arrays.reboot_payload_name));
+   }
+
+   menu_st->flags |= MENU_ST_FLAG_ENTRIES_NEED_REFRESH;
+   return 0;
+}
+#endif
+
 static int core_setting_left(unsigned type, const char *label,
       bool wraparound)
 {
@@ -1362,6 +1392,11 @@ static int menu_cbs_init_bind_left_compare_label(menu_file_list_cbs_t *cbs,
                BIND_ACTION_LEFT(cbs, gpu_policy_freq_managed_tweak);
                break;
             #endif
+            #ifdef HAVE_LAKKA_SWITCH
+            case MENU_ENUM_LABEL_REBOOT_PAYLOAD:
+               BIND_ACTION_LEFT(cbs, reboot_payload_left);
+               break;
+            #endif
             default:
                return -1;
          }
