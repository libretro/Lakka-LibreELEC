             strlcpy(mb->root, devs->elems[i].data, sizeof(mb->root));
@@ -384,7 +384,7 @@ static bool resolve_root(sys_clk_state_t *st)
                mb->root[l + 1] = '\0';
             }
             RARCH_LOG("[sys-clk]: using GPU devfreq device %s\n", mb->root);
-         }*/
