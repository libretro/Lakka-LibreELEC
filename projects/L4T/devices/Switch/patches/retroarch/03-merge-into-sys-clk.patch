-
-         fill_pathname_join(fpath, policy_dir->elems[i].data,
-            "scaling_max_freq", sizeof(fpath));
-         readparse_uint32(fpath, &drv->max_policy_freq);
-
-         fill_pathname_join(fpath, policy_dir->elems[i].data,
-            "scaling_available_governors", sizeof(fpath));
