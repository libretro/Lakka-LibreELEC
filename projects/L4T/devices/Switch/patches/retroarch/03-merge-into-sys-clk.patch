-               #if 0//def GPU_DEBUG
-               RARCH_LOG("[GPU_DEBUG] Available Freq (%i): %u\n", j, drv->available_freqs[j]);
-               #endif
-               if (abs_min_freq > freq || abs_min_freq == 1)
