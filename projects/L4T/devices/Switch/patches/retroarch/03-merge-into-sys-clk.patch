-               if (abs_max_freq < freq || abs_max_freq == ~0U)
-                  abs_max_freq = freq;
-            }
-            freq_count = tmplst->size;
-            string_list_free(tmplst);
-            int a, b;
-            for (a =0; a < freq_count -1; a++)
