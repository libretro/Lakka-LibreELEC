From 360a5fa2f9cf29d56f0ee8267a9c98b54bbc5064 Mon Sep 17 00:00:00 2001
From: a <a@b.c>
Date: Thu, 3 Sep 2026 18:18:18 +0000
Subject: [PATCH] arm64: tegra_linux_defconfig: enable Joy-Con MCU (tera): NFC,
 IR camera

Turn on the shared Nintendo Switch controller MCU core and its features in
the default T210 config, over both transports:

  CONFIG_NFC=y                     (net/nfc; needed by the NFC feature and
                                    by userspace stacks like neard/libnfc)
  CONFIG_MISC_NINTENDO_TERA=y      (transport-agnostic MCU core)
  CONFIG_MISC_NINTENDO_TERA_NFC=y  (NFC tag reader)
  CONFIG_MISC_NINTENDO_TERA_IR=y   (NIR camera as V4L2)
  CONFIG_HID_NINTENDO_TERA=y       (enable MCU features over Bluetooth/USB)
  CONFIG_JOYCON_SERDEV_TERA=y      (enable MCU features over UART/serdev)

The MCU core moved to drivers/misc, so the options are MISC_NINTENDO_TERA*
now (was NINTENDO_TERA* / HID_NINTENDO_{NFC,IR_CAMERA} before the refactor).
IR_CAMERA's 'select VIDEOBUF2_VMALLOC' pulls its videobuf2 backend; the V4L2
core is already enabled in the base config.
---
 arch/arm64/configs/tegra_linux_defconfig | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/configs/tegra_linux_defconfig b/arch/arm64/configs/tegra_linux_defconfig
index 884d37f..279ec6b 100644
--- a/arch/arm64/configs/tegra_linux_defconfig
+++ b/arch/arm64/configs/tegra_linux_defconfig
@@ -491,6 +491,11 @@ CONFIG_BT_HCIBTUSB_BCM=y
 CONFIG_BT_HCIBTUSB_RTL=y
 CONFIG_BT_HCIUART=m
 CONFIG_BT_HCIUART_BCM=y
+
+#
+# NFC subsystem support (Joy-Con NFC + userspace stacks: neard/libnfc)
+#
+CONFIG_NFC=y
 CONFIG_CFG80211=y
 # CONFIG_CFG80211_DEFAULT_PS is not set
 CONFIG_CFG80211_DEBUGFS=y
@@ -552,6 +557,9 @@ CONFIG_BLK_DEV_RAM_SIZE=8192
 # Misc devices
 #
 CONFIG_SRAM=y
+CONFIG_MISC_NINTENDO_TERA=y
+CONFIG_MISC_NINTENDO_TERA_NFC=y
+CONFIG_MISC_NINTENDO_TERA_IR=y
 CONFIG_BLUEDROID_PM=m
 CONFIG_BM92TXX=y
 
@@ -761,6 +769,7 @@ CONFIG_KEYBOARD_GPIO=y
 CONFIG_INPUT_JOYSTICK=y
 CONFIG_JOYSTICK_JOYCON_SERDEV=m
 CONFIG_JOYCON_SERDEV_FF=y
+CONFIG_JOYCON_SERDEV_TERA=y
 CONFIG_JOYSTICK_XPAD=m
 CONFIG_JOYSTICK_XPAD_FF=y
 CONFIG_JOYSTICK_XPAD_LEDS=y
@@ -1371,6 +1380,7 @@ CONFIG_HID_MAGICMOUSE=y
 CONFIG_HID_MICROSOFT=y
 CONFIG_HID_MULTITOUCH=y
 CONFIG_HID_NINTENDO=y
+CONFIG_HID_NINTENDO_TERA=y
 CONFIG_NINTENDO_FF=y
 CONFIG_HID_NTRIG=y
 CONFIG_HID_ORTEK=y
