+/* IR illuminator control for the metadata node (default on, unlike the image
+ * node which defaults off: clustering/DPD need active light). */
+static int joycon_ir_meta_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct joycon_ir_priv *priv = container_of(ctrl->handler,
+			struct joycon_ir_priv, meta_ctrl_handler);
+
+	if (ctrl->id == JOYCON_CID_IR_META_ILLUM) {
+		priv->meta_led_on = ctrl->val;
+		return 0;
+	}
+	return -EINVAL;
+}
