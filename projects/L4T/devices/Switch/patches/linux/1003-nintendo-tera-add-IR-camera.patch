+/* ---- meta ioctl ops ---- */
+
+static const u32 joycon_ir_meta_fmts[] = {
+	V4L2_META_FMT_JC_CLUSTER,
+	V4L2_META_FMT_JC_MOMENT,
+	V4L2_META_FMT_JC_DPD,
+};
+
+static int joycon_ir_meta_querycap(struct file *file, void *fh,
+				   struct v4l2_capability *cap)
+{
+	strscpy((char *)cap->driver, "hid_nintendo", sizeof(cap->driver));
+	strscpy((char *)cap->card, "Joy-Con NIR metadata", sizeof(cap->card));
+	cap->device_caps = V4L2_CAP_META_CAPTURE | V4L2_CAP_STREAMING;
+	cap->capabilities = cap->device_caps | V4L2_CAP_DEVICE_CAPS;
+	return 0;
+}
+
+static int joycon_ir_meta_enum_fmt(struct file *file, void *fh,
+				   struct v4l2_fmtdesc *f)
+{
+	if (f->index >= ARRAY_SIZE(joycon_ir_meta_fmts))
+		return -EINVAL;
+	f->pixelformat = joycon_ir_meta_fmts[f->index];
+	return 0;
+}
+
+static int joycon_ir_meta_g_fmt(struct file *file, void *fh,
+				struct v4l2_format *f)
+{
+	struct joycon_tera *tera = video_drvdata(file);
+	struct joycon_ir_priv *priv = tera->mcu.ir.priv;
+
+	f->fmt.meta.dataformat = priv->meta_fourcc;
+	f->fmt.meta.buffersize = joycon_ir_meta_bufsize(priv->meta_fourcc);
+	return 0;
+}
+
+static int joycon_ir_meta_try_fmt(struct file *file, void *fh,
+				  struct v4l2_format *f)
+{
+	if (!joycon_ir_fourcc_mode(f->fmt.meta.dataformat))
+		f->fmt.meta.dataformat = V4L2_META_FMT_JC_CLUSTER;
+	f->fmt.meta.buffersize = joycon_ir_meta_bufsize(f->fmt.meta.dataformat);
+	return 0;
+}
+
+static int joycon_ir_meta_s_fmt(struct file *file, void *fh,
+				struct v4l2_format *f)
+{
+	struct joycon_tera *tera = video_drvdata(file);
+	struct joycon_ir_priv *priv = tera->mcu.ir.priv;
+
+	if (vb2_is_busy(&priv->meta_vbq))
+		return -EBUSY;
+	joycon_ir_meta_try_fmt(file, fh, f);
+	priv->meta_fourcc = f->fmt.meta.dataformat;
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops joycon_ir_meta_ioctl_ops = {
+	.vidioc_querycap          = joycon_ir_meta_querycap,
+	.vidioc_enum_fmt_meta_cap = joycon_ir_meta_enum_fmt,
+	.vidioc_g_fmt_meta_cap    = joycon_ir_meta_g_fmt,
+	.vidioc_s_fmt_meta_cap    = joycon_ir_meta_s_fmt,
+	.vidioc_try_fmt_meta_cap  = joycon_ir_meta_try_fmt,
+	.vidioc_reqbufs           = vb2_ioctl_reqbufs,
+	.vidioc_querybuf          = vb2_ioctl_querybuf,
+	.vidioc_qbuf              = vb2_ioctl_qbuf,
+	.vidioc_dqbuf             = vb2_ioctl_dqbuf,
+	.vidioc_streamon          = vb2_ioctl_streamon,
+	.vidioc_streamoff         = vb2_ioctl_streamoff,
+};
