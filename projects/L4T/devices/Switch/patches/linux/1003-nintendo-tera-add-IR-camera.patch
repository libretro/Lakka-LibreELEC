+/* ---- v4l2 ioctl ops ---- */
+
+static int joycon_ir_querycap(struct file *file, void *fh,
+			      struct v4l2_capability *cap)
+{
+	strscpy((char *)cap->driver, "hid_nintendo", sizeof(cap->driver));
+	strscpy((char *)cap->card,   "Joy-Con NIR",  sizeof(cap->card));
+	cap->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING |
+			   V4L2_CAP_READWRITE;
+	cap->capabilities = cap->device_caps | V4L2_CAP_DEVICE_CAPS;
+	return 0;
+}
+
+static int joycon_ir_enum_fmt(struct file *file, void *fh,
+			      struct v4l2_fmtdesc *f)
+{
+	if (f->index > 0)
+		return -EINVAL;
+	f->pixelformat = V4L2_PIX_FMT_GREY;
+	strscpy((char *)f->description, "8bpp greyscale",
+		sizeof(f->description));
+	return 0;
+}
+
+static int joycon_ir_g_fmt(struct file *file, void *fh,
+			   struct v4l2_format *f)
+{
+	struct joycon_tera *tera = video_drvdata(file);
+	struct joycon_ir_priv *priv = tera->mcu.ir.priv;
+	unsigned int idx = priv->res_idx;
+
+	f->fmt.pix.pixelformat = V4L2_PIX_FMT_GREY;
+	f->fmt.pix.width       = joycon_ir_resolutions[idx].width;
+	f->fmt.pix.height      = joycon_ir_resolutions[idx].height;
+	f->fmt.pix.field       = V4L2_FIELD_NONE;
+	f->fmt.pix.bytesperline = joycon_ir_resolutions[idx].width;
+	f->fmt.pix.sizeimage   =
+		((unsigned int)joycon_ir_resolutions[idx].max_frag + 1) * 300;
+	f->fmt.pix.colorspace  = V4L2_COLORSPACE_RAW;
+	return 0;
+}
+
+static int joycon_ir_try_fmt(struct file *file, void *fh,
+			     struct v4l2_format *f)
+{
+	int i, idx = ARRAY_SIZE(joycon_ir_resolutions) - 1;
+
+	/*
+	 * The table is ordered largest-first. Pick the largest entry
+	 * that fits inside the caller's requested dimensions; if
+	 * nothing fits, fall back to the smallest (idx set above).
+	 */
+	for (i = 0; i < (int)ARRAY_SIZE(joycon_ir_resolutions); i++) {
+		if (f->fmt.pix.width  >= joycon_ir_resolutions[i].width &&
+		    f->fmt.pix.height >= joycon_ir_resolutions[i].height) {
+			idx = i;
+			break;
+		}
+	}
+
+	f->fmt.pix.pixelformat = V4L2_PIX_FMT_GREY;
+	f->fmt.pix.width       = joycon_ir_resolutions[idx].width;
+	f->fmt.pix.height      = joycon_ir_resolutions[idx].height;
+	f->fmt.pix.field       = V4L2_FIELD_NONE;
+	f->fmt.pix.bytesperline = joycon_ir_resolutions[idx].width;
+	f->fmt.pix.sizeimage   =
+		((unsigned int)joycon_ir_resolutions[idx].max_frag + 1) * 300;
+	f->fmt.pix.colorspace  = V4L2_COLORSPACE_RAW;
+	return 0;
+}
+
+static int joycon_ir_s_fmt(struct file *file, void *fh,
+			   struct v4l2_format *f)
+{
+	struct joycon_tera *tera = video_drvdata(file);
+	struct joycon_ir_priv *priv = tera->mcu.ir.priv;
+	int i;
+
+	if (vb2_is_busy(&priv->vbq))
+		return -EBUSY;
+
+	joycon_ir_try_fmt(file, fh, f);
+	for (i = 0; i < (int)ARRAY_SIZE(joycon_ir_resolutions); i++) {
+		if (f->fmt.pix.width == joycon_ir_resolutions[i].width) {
+			priv->res_idx = i;
+			break;
+		}
+	}
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops joycon_ir_ioctl_ops = {
+	.vidioc_querycap         = joycon_ir_querycap,
+	.vidioc_enum_fmt_vid_cap = joycon_ir_enum_fmt,
+	.vidioc_g_fmt_vid_cap    = joycon_ir_g_fmt,
+	.vidioc_s_fmt_vid_cap    = joycon_ir_s_fmt,
+	.vidioc_try_fmt_vid_cap  = joycon_ir_try_fmt,
+	.vidioc_reqbufs          = vb2_ioctl_reqbufs,
+	.vidioc_querybuf         = vb2_ioctl_querybuf,
+	.vidioc_qbuf             = vb2_ioctl_qbuf,
+	.vidioc_dqbuf            = vb2_ioctl_dqbuf,
+	.vidioc_streamon         = vb2_ioctl_streamon,
+	.vidioc_streamoff        = vb2_ioctl_streamoff,
+};
+
+static const struct v4l2_file_operations joycon_ir_fops = {
+	.owner          = THIS_MODULE,
+	.open           = v4l2_fh_open,
+	.release        = vb2_fop_release,
+	.read           = vb2_fop_read,
+	.poll           = vb2_fop_poll,
+	.mmap           = vb2_fop_mmap,
+	.unlocked_ioctl = video_ioctl2,
+};
+
+/* ---- v4l2 controls ---- */
+
+/* IR illuminator custom control IDs (see joycon_ir_ctrl_leds below). */
+#define JOYCON_CID_IR_LEDS		(V4L2_CID_USER_BASE + 0x1000)
+#define JOYCON_CID_IR_LED_INTENSITY	(V4L2_CID_USER_BASE + 0x1001)
+
+static int joycon_ir_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct joycon_ir_priv *priv =
+		container_of(ctrl->handler, struct joycon_ir_priv,
+			     ctrl_handler);
+
+	pr_info("joycon_ir_s_ctrl: id=0x%08x val=%d\n", ctrl->id, ctrl->val);
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		/*
+		 * 24-bit exposure register. Max ~537 sec at 31.2 MHz.
+		 * We cap at 0x00ffff (~2.1 sec) by default to avoid
+		 * pathologically long exposures freezing streaming.
+		 */
+		priv->exposure = clamp_val(ctrl->val, 0, 0xffff);
+		break;
+	case V4L2_CID_GAIN:
+		/*
+		 * 4-bit dgain lookup index (0..15). Nintendo's sysmodule
+		 * uses a table at rodata 0x1c200c; effectively the value
+		 * written to reg 0x012e is (index << 4).
+		 */
+		priv->digital_gain = clamp_val(ctrl->val, 0, 15);
+		break;
+	case V4L2_CID_HFLIP:
+		priv->flip = (priv->flip & ~0x02) | (ctrl->val ? 0x02 : 0);
+		break;
+	case V4L2_CID_VFLIP:
+		priv->flip = (priv->flip & ~0x01) | (ctrl->val ? 0x01 : 0);
+		break;
+	case JOYCON_CID_IR_LEDS:
+		/* LED-group select -> reg 0x0010 via joycon_ir_led_map[]. */
+		priv->leds = ctrl->val & 0x03;
+		break;
+	case JOYCON_CID_IR_LED_INTENSITY:
+		/* -> regs 0x0011 (hi) / 0x0012 (lo). */
+		priv->leds_intensity = ctrl->val & 0xffff;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops joycon_ir_ctrl_ops = {
+	.s_ctrl = joycon_ir_s_ctrl,
+};
+
+/*
+ * IR illumination controls. The near-IR LEDs are a flood illuminator for the
+ * camera; expose which LED group(s) are lit (reg 0x0010 via joycon_ir_led_map)
+ * and their intensity (regs 0x0011/0x0012). Like exposure/gain these are latched
+ * into the register block at the next STREAMON, not applied live.
+ */
+static const char * const joycon_ir_led_menu[] = {
+	"Off", "Group 1", "Group 2", "Both",
+};
+
+static const struct v4l2_ctrl_config joycon_ir_ctrl_leds = {
+	.ops	= &joycon_ir_ctrl_ops,
+	.id	= JOYCON_CID_IR_LEDS,
+	.name	= "IR Illuminator",
+	.type	= V4L2_CTRL_TYPE_MENU,
+	.min	= 0,
+	.max	= ARRAY_SIZE(joycon_ir_led_menu) - 1,
+	.def	= 0,			/* Off (reg 0x30); "Both"=0x00 floods */
+	.qmenu	= joycon_ir_led_menu,
+};
+
+static const struct v4l2_ctrl_config joycon_ir_ctrl_led_intensity = {
+	.ops	= &joycon_ir_ctrl_ops,
+	.id	= JOYCON_CID_IR_LED_INTENSITY,
+	.name	= "IR Illuminator Intensity",
+	.type	= V4L2_CTRL_TYPE_INTEGER,
+	.min	= 0,
+	.max	= 0xffff,
+	.step	= 1,
+	.def	= 0x0f10,
+};
+
+/* ---- register / unregister ---- */
+
+int joycon_ir_register(struct joycon_tera *tera)
+{
+	struct joycon_ir_priv *priv;
+	struct video_device *vdev;
+	struct vb2_queue *q;
+	int ret;
+
+	/*
+	 * The NIR camera lives only in the right Joy-Con (0x2007). Pro
+	 * Controller has NFC but not a camera; left Joy-Con and Charging
+	 * Grip left-half have neither. Skip publication for anything
+	 * else -- including third-party clones with spoofed VID/PID --
+	 * so userspace never sees a non-functional /dev/videoN.
+	 *
+	 * jc_supports_ir() covers both the USB product ID and the MCU
+	 * self-reported controller type. The MCU-responsive gate is the
+	 * separate belt-and-suspenders check that catches clones with
+	 * spoofed Nintendo VID/PID but no working MCU.
+	 */
+	if (!jc_supports_ir(tera))
+		return 0;
+	if (!tera->mcu.responsive) {
+		dev_info(tera->dev,
+			 "IR register: skipping (MCU probe failed at .probe time)\n");
+		return 0;
+	}
+
+	priv = kzalloc(sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	mutex_init(&priv->vb_lock);
+	spin_lock_init(&priv->buf_lock);
+	INIT_LIST_HEAD(&priv->buf_queue);
+	spin_lock_init(&priv->meta.lock);
+	priv->meta_led_on = true;	/* illuminate scene in metadata modes */
+	priv->tera = tera;
+	INIT_DELAYED_WORK(&priv->poke_work, joycon_ir_poke_work);
+
+	priv->res_idx          = 0;
+	priv->exposure         = 0x2490;	/* ~300us in encoded units */
+	priv->digital_gain     = 8;		/* mid dgain (index 8 -> 0x80) */
+	priv->ext_light_filter = 0x00;		/* ExLF off */
+	priv->flip             = 0;
+	priv->leds             = 0x00;		/* menu "Off" -> reg 0x0010 = 0x30 */
+	priv->leds_intensity   = 0x0F10;
+
+	ret = v4l2_device_register(tera->dev, &priv->v4l2_dev);
+	if (ret)
+		goto err_priv;
+
+	v4l2_ctrl_handler_init(&priv->ctrl_handler, 6);
+	v4l2_ctrl_new_std(&priv->ctrl_handler, &joycon_ir_ctrl_ops,
+			  V4L2_CID_EXPOSURE, 0, 0xffff, 1, priv->exposure);
+	v4l2_ctrl_new_std(&priv->ctrl_handler, &joycon_ir_ctrl_ops,
+			  V4L2_CID_GAIN, 0, 15, 1, priv->digital_gain);
+	v4l2_ctrl_new_std(&priv->ctrl_handler, &joycon_ir_ctrl_ops,
+			  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	v4l2_ctrl_new_std(&priv->ctrl_handler, &joycon_ir_ctrl_ops,
+			  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	v4l2_ctrl_new_custom(&priv->ctrl_handler, &joycon_ir_ctrl_leds, NULL);
+	v4l2_ctrl_new_custom(&priv->ctrl_handler,
+			     &joycon_ir_ctrl_led_intensity, NULL);
+	if (priv->ctrl_handler.error) {
+		ret = priv->ctrl_handler.error;
+		goto err_ctrl;
+	}
+	priv->v4l2_dev.ctrl_handler = &priv->ctrl_handler;
+
+	q = &priv->vbq;
+	q->type            = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	q->io_modes        = VB2_MMAP | VB2_USERPTR | VB2_READ;
+	q->buf_struct_size = sizeof(struct joycon_ir_buffer);
+	q->ops             = &joycon_ir_vb2_ops;
+	q->mem_ops         = &vb2_vmalloc_memops;
+	q->drv_priv        = tera;
+	q->lock            = &priv->vb_lock;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	ret = vb2_queue_init(q);
+	if (ret)
+		goto err_ctrl;
+
+	vdev = &priv->vdev;
+	strscpy(vdev->name, "Joy-Con NIR", sizeof(vdev->name));
+	vdev->v4l2_dev    = &priv->v4l2_dev;
+	vdev->fops        = &joycon_ir_fops;
+	vdev->ioctl_ops   = &joycon_ir_ioctl_ops;
+	vdev->release     = video_device_release_empty;
+	vdev->lock        = &priv->vb_lock;
+	vdev->queue       = q;
+	vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING |
+			    V4L2_CAP_READWRITE;
+	video_set_drvdata(vdev, tera);
+
+	ret = video_register_device(vdev, VFL_TYPE_GRABBER, -1);
+	if (ret)
+		goto err_ctrl;
+
+	tera->mcu.ir.priv = priv;
+	tera->mcu.ir.recv_frag = joycon_ir_recv_frag;
+
+	/* Second node: IR metadata (moment/clustering/DPD) capture. Shares
+	 * priv->v4l2_dev with the image node above. */
+	mutex_init(&priv->meta_vb_lock);
+	spin_lock_init(&priv->meta_buf_lock);
+	INIT_LIST_HEAD(&priv->meta_bufs);
+	priv->meta_fourcc = V4L2_META_FMT_JC_CLUSTER;
+
+	v4l2_ctrl_handler_init(&priv->meta_ctrl_handler, 1);
+	v4l2_ctrl_new_custom(&priv->meta_ctrl_handler,
+			     &joycon_ir_ctrl_meta_illum, NULL);
+	if (priv->meta_ctrl_handler.error) {
+		ret = priv->meta_ctrl_handler.error;
+		goto err_meta;
+	}
+
+	q = &priv->meta_vbq;
+	q->type            = V4L2_BUF_TYPE_META_CAPTURE;
+	q->io_modes        = VB2_MMAP | VB2_READ;
+	q->buf_struct_size = sizeof(struct joycon_ir_buffer);
+	q->ops             = &joycon_ir_meta_vb2_ops;
+	q->mem_ops         = &vb2_vmalloc_memops;
+	q->drv_priv        = tera;
+	q->lock            = &priv->meta_vb_lock;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	ret = vb2_queue_init(q);
+	if (ret)
+		goto err_meta;
+
+	vdev = &priv->meta_vdev;
+	strscpy(vdev->name, "Joy-Con NIR metadata", sizeof(vdev->name));
+	vdev->v4l2_dev     = &priv->v4l2_dev;
+	vdev->fops         = &joycon_ir_fops;
+	vdev->ioctl_ops    = &joycon_ir_meta_ioctl_ops;
+	vdev->release      = video_device_release_empty;
+	vdev->lock         = &priv->meta_vb_lock;
+	vdev->queue        = q;
+	vdev->device_caps  = V4L2_CAP_META_CAPTURE | V4L2_CAP_STREAMING;
+	vdev->ctrl_handler = &priv->meta_ctrl_handler;
+	video_set_drvdata(vdev, tera);
+
+	ret = video_register_device(vdev, VFL_TYPE_GRABBER, -1);
+	if (ret)
+		goto err_meta;
+
+	return 0;
+
+err_meta:
+	v4l2_ctrl_handler_free(&priv->meta_ctrl_handler);
+	video_unregister_device(&priv->vdev);
+	tera->mcu.ir.recv_frag = NULL;
+	tera->mcu.ir.priv = NULL;
+
+err_ctrl:
+	v4l2_ctrl_handler_free(&priv->ctrl_handler);
+	v4l2_device_unregister(&priv->v4l2_dev);
+err_priv:
+	kfree(priv);
+	return ret;
+}
+
+void joycon_ir_unregister(struct joycon_tera *tera)
+{
+	struct joycon_ir_priv *priv = tera->mcu.ir.priv;
+
+	if (!priv)
+		return;
+
+	tera->mcu.ir.streaming = false;
+	cancel_delayed_work_sync(&priv->poke_work);
+
+	video_unregister_device(&priv->meta_vdev);
+	v4l2_ctrl_handler_free(&priv->meta_ctrl_handler);
+	video_unregister_device(&priv->vdev);
+	v4l2_ctrl_handler_free(&priv->ctrl_handler);
+	v4l2_device_unregister(&priv->v4l2_dev);
+
+	tera->mcu.ir.recv_frag = NULL;
+	tera->mcu.ir.priv = NULL;
+	kfree(priv);
+}
+
