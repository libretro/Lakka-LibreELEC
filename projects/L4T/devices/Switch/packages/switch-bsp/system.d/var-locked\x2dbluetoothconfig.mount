[Unit]
Description=mount bluez filesystem
Before=bluetooth.service
ConditionKernelCommandLine=|upfs-storage
ConditionKernelCommandLine=|upfsps-storage

[Mount]
What=/storage/.cache/bluetooth
Where=/var/locked-bluetoothconfig
Type=rewritefs
Options=allow_other,config=/etc/rewritefs.conf

[Install]
WantedBy=multi-user.target

